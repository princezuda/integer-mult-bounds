    (bitRows.map Prod.fst).max? = some 529 ∧
    (cxRows.map Prod.fst).max? = some 756 := by
  refine ⟨by norm_num, by norm_num, by norm_num, by norm_num, by decide, by decide⟩

/-- rank mass: `Σ t n_t = s`, with `s_b = W m - N + L` (copied centres) -/
theorem rank_mass : (bitRows.map fun r => r.1 * r.2).sum = 137151806 * 575 - 4073300 + 2226400 ∧
    (cxRows.map fun r => r.1 * r.2).sum = 421548223824 := by
  constructor <;> decide

