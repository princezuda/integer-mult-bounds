/-- `halving_degree(m, child)`: the least `d ≥ 1` with `m^d > 2·child^d` -/
def IsHalvingDegree (m child d : ℕ) : Prop :=
  1 ≤ d ∧ 2 * child ^ d < m ^ d ∧ ∀ k, 1 ≤ k → k < d → m ^ k ≤ 2 * child ^ k

theorem bit_halving : IsHalvingDegree 575 529 9 := by
  refine ⟨by norm_num, by norm_num, fun k h1 h2 => ?_⟩
  interval_cases k <;> norm_num

theorem cx_halving : IsHalvingDegree 784 756 20 := by
  refine ⟨by norm_num, by norm_num, fun k h1 h2 => ?_⟩
  interval_cases k <;> norm_num

/-- `W.bit_length()` for both networks, and the largest child of each row list -/
theorem wire_bits : 2 ^ 27 ≤ 137151806 ∧ 137151806 < 2 ^ 28 ∧
