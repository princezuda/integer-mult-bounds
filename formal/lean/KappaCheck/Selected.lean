/-- complex network: the rational side conditions of `term_le` and `le_term` -/
theorem cx_hints : ∀ r ∈ cxRows, 0 < r.1 ∧ r.1 < 784 ∧ 0 ≤ cxHlo r.1 ∧
    aC * cxHhi r.1 ≤ 1 ∧ P4 (aC * cxHhi r.1) ≤ cxU r.1 ∧
    cxD r.1 ≤ S5 ((aC + 1 / 10000000) * cxHlo r.1) := by
  intro r hr
  simp only [cxRows, List.mem_cons, List.not_mem_nil, or_false] at hr
  rcases hr with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> norm_num [cxHlo, cxHhi, cxU, cxD, aC, P4, S5]

/-- complex network: `Φ(a) < 1`, the source's moment test -/
theorem cx_moment : Φ 784 537696432 cxRows (aC : ℝ) < 1 := by
  apply moment_lt_one (U := fun t => (cxU t : ℝ)) (by norm_num)
  · intro r hr
    obtain ⟨h0, hm, -, h1, h2, -⟩ := cx_hints r hr
    exact term_le (by exact_mod_cast h0) (by exact_mod_cast hm.le) (by norm_num [aC])
      (cx_logs r hr).2 (by exact_mod_cast h1) (by unfold P4 at h2; exact_mod_cast h2)
  · simp only [cxRows, cxU, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]
    norm_num

/-- negative control: `Φ(a + 1 / 10000000) > 1`, so the moment test is tight -/
theorem cx_moment_tight : 1 < Φ 784 537696432 cxRows ((aC : ℝ) + 1 / 10000000) := by
  rw [show (aC : ℝ) + 1 / 10000000 = ((aC + 1 / 10000000 : ℚ) : ℝ) by push_cast; ring]
  apply one_lt_moment (D := fun t => (cxD t : ℝ)) (by norm_num)
  · intro r hr
    obtain ⟨h0, hm, hl, -, -, h3⟩ := cx_hints r hr
    exact le_term (by exact_mod_cast h0) (by exact_mod_cast hm.le) (by norm_num [aC])
      (cx_logs r hr).1 (by exact_mod_cast hl) (by unfold S5 at h3; exact_mod_cast h3)
  · simp only [cxRows, cxD, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]
    norm_num

